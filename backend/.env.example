# Copy this file to .env and replace values where necessary.
# Spring imports .env automatically when the backend starts from this directory.

SPRING_APPLICATION_NAME=backend

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/football_market
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

JWT_SECRET=clave-local-de-desarrollo-de-32-bytes-minimo

SPRINGDOC_SHOW_ACTUATOR=true
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health

# Obtain a token at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=replace_with_your_football_data_api_key
FOOTBALL_DATA_API_URL=https://api.football-data.org/v4
FOOTBALL_DATA_SCHEDULER_CRON=0 0 0 * * SUN
FOOTBALL_DATA_STARTUP_ENABLED=true

WHOSCORED_SCRAPING_HEADLESS=true
WHOSCORED_SCRAPING_NAVIGATION_TIMEOUT_MS=30000
WHOSCORED_SCRAPING_REQUEST_TIMEOUT_MS=15000
WHOSCORED_SCRAPING_USER_AGENT=Los-Recursionistas/1.0
WHOSCORED_SCRAPING_BASE_URL=https://www.whoscored.com
WHOSCORED_SCRAPING_PAUSE_MS=1000
WHOSCORED_SCRAPING_RATE_LIMIT_PER_MINUTE=30
WHOSCORED_SCRAPING_MAX_RETRIES=2
WHOSCORED_SCRAPING_BACKOFF_MS=2000
WHOSCORED_SEASON_START=2025-08-01
WHOSCORED_SEASON_END=2026-06-30
# Empty means all leagues. For specific leagues, use comma-separated IDs.
WHOSCORED_ALLOWED_LEAGUES=
WHOSCORED_STARTUP_ENABLED=true
